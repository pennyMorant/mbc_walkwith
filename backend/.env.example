NODE_ENV=development
PORT=3020
HOST=127.0.0.1
PUBLIC_API_BASE_URL=http://localhost:3020/v1
ADMIN_WEB_ORIGIN=http://localhost:5173

# First skeleton uses in-memory repositories when this is true.
USE_MOCK_DATA=true

DATABASE_URL=postgres://postgres:postgres@localhost:5432/mbc_walkwith

# Sermon audio/media storage. Use local for dev, s3 for S3/R2/MinIO.
MEDIA_STORAGE_DRIVER=local
MEDIA_UPLOAD_DIR=uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mbc-walkwith-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# AI provider gateway. Supported providers: disabled, openai, gemini,
# openai_compatible. Keys stay server-side only.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
AI_AUDIT_ENABLED=true
AI_EXTRA_HEADERS_JSON=
AI_RATE_LIMIT_WINDOW_MS=60000
AI_ADMIN_RATE_LIMIT_PER_WINDOW=20
AI_MEMBER_RATE_LIMIT_PER_WINDOW=10

# Giving / Stripe. Leave empty in local mock mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
GIVING_CHECKOUT_SUCCESS_URL=mbcwalkwith://mine/giving?checkout=success
GIVING_CHECKOUT_CANCEL_URL=mbcwalkwith://mine/giving?checkout=cancel

# Push notifications. Missing FCM JSON keeps delivery on the noop provider.
FCM_SERVICE_ACCOUNT_JSON=
# Firebase Auth token verification. May reuse FCM_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
MEMBER_AUTH_RATE_LIMIT_WINDOW_MS=60000
MEMBER_AUTH_RATE_LIMIT_PER_WINDOW=10
FCM_HTTP_TIMEOUT_MS=10000
NOTIFICATION_RETRY_SCHEDULER_ENABLED=false
NOTIFICATION_RETRY_SCHEDULER_INTERVAL_MS=60000
NOTIFICATION_RETRY_SCHEDULER_BATCH_SIZE=20

# Member registration email verification. Development exposes a dev code;
# production requires Resend when member.requireEmailVerification is enabled.
MEMBER_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
MEMBER_EMAIL_FROM=
MEMBER_EMAIL_REPLY_TO=
MEMBER_EMAIL_HTTP_TIMEOUT_MS=10000

auth_secret=dev-only-change-me-minimum-32-characters
app_user_auth_secret=dev-only-change-me-minimum-32-characters
DEV_ADMIN_EMAIL=admin@mbc.local
DEV_ADMIN_PASSWORD=password123
BOOTSTRAP_DEV_ADMIN=true
