NODE_ENV=production
PORT=3020
HOST=127.0.0.1
TRUST_PROXY=127.0.0.1

# The deployment script configures these from:
#   --api-origin   -> PUBLIC_API_BASE_URL=<origin>/v1
#   --admin-origin -> ADMIN_WEB_ORIGIN=<origin>
PUBLIC_API_BASE_URL=https://api.example.com/v1
ADMIN_WEB_ORIGIN=https://admin.example.com

USE_MOCK_DATA=false

DATABASE_URL=postgres://mbc_walkwith:<password>@127.0.0.1:5432/mbc_walkwith

# Sermon audio/media storage. Production should normally use S3-compatible
# storage such as Cloudflare R2.
MEDIA_STORAGE_DRIVER=s3
MEDIA_UPLOAD_DIR=uploads
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mbc-walkwith-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# AI provider gateway. Supported providers: disabled, openai, gemini,
# openai_compatible. Use AI_BASE_URL for third-party OpenAI-compatible relays.
AI_PROVIDER=disabled
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1200
AI_AUDIT_ENABLED=true
AI_EXTRA_HEADERS_JSON=
AI_RATE_LIMIT_WINDOW_MS=60000
AI_ADMIN_RATE_LIMIT_PER_WINDOW=20
AI_MEMBER_RATE_LIMIT_PER_WINDOW=10

auth_secret=replace-with-production-secret
app_user_auth_secret=replace-with-production-secret
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=replace-before-first-deploy
BOOTSTRAP_DEV_ADMIN=false

# Push notifications
# Use a single-line JSON string, for example:
# FCM_SERVICE_ACCOUNT_JSON=$(jq -c . service-account.json)
FCM_SERVICE_ACCOUNT_JSON=
# Firebase Auth token verification. May reuse FCM_SERVICE_ACCOUNT_JSON.
FIREBASE_SERVICE_ACCOUNT_JSON=
MEMBER_AUTH_RATE_LIMIT_WINDOW_MS=60000
MEMBER_AUTH_RATE_LIMIT_PER_WINDOW=10
FCM_HTTP_TIMEOUT_MS=10000
NOTIFICATION_RETRY_SCHEDULER_ENABLED=false
NOTIFICATION_RETRY_SCHEDULER_INTERVAL_MS=60000
NOTIFICATION_RETRY_SCHEDULER_BATCH_SIZE=20

# Member registration email verification. Set all values before enabling
# member.requireEmailVerification in Admin Settings.
MEMBER_EMAIL_PROVIDER=disabled
RESEND_API_KEY=
MEMBER_EMAIL_FROM=
MEMBER_EMAIL_REPLY_TO=
MEMBER_EMAIL_HTTP_TIMEOUT_MS=10000

# Giving / Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
GIVING_CHECKOUT_SUCCESS_URL=mbcwalkwith://mine/giving?checkout=success
GIVING_CHECKOUT_CANCEL_URL=mbcwalkwith://mine/giving?checkout=cancel
