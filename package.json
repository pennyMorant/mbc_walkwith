{
  "name": "mbc-walkwith",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "apps/admin_web",
    "apps/public_web",
    "packages/api_contracts",
    "packages/shared_types",
    "packages/ui_tokens"
  ],
  "scripts": {
    "local:init": "bash tools/scripts/local/local_environment.sh init",
    "local:check": "bash tools/scripts/local/local_environment.sh check",
    "local:api": "bash tools/scripts/local/local_environment.sh api",
    "local:admin": "bash tools/scripts/local/local_environment.sh admin",
    "local:public": "bash tools/scripts/local/local_environment.sh public",
    "local:web": "bash tools/scripts/local/local_environment.sh web",
    "local:mobile": "bash tools/scripts/local/local_environment.sh mobile",
    "dev:api": "bun run dev:backend",
    "dev:web": "bun run dev:admin",
    "dev:backend": "cd backend && bun --watch src/main.ts",
    "dev:admin": "cd apps/admin_web && bun run dev",
    "dev:public": "cd apps/public_web && bun run dev",
    "preview:admin": "cd apps/admin_web && bun run preview",
    "preview:public": "cd apps/public_web && bun run preview",
    "db:generate": "cd backend && bun run db:generate",
    "db:migrate": "cd backend && bun run db:migrate",
    "db:check": "cd backend && bun run db:check",
    "db:smoke": "cd backend && bun run db:smoke",
    "db:seed:bible-knowledge": "cd backend && bun run db:seed:bible-knowledge",
    "build:admin": "cd apps/admin_web && bun run build",
    "build:public": "cd apps/public_web && bun run build",
    "build:api": "bun build backend/src/main.ts --target=bun --outdir=dist/backend_dist --entry-naming='[dir]/[name].js'",
    "build:prebuilt": "bash tools/scripts/release/build_prebuilt.sh",
    "build": "bun run build:admin && bun run build:public",
    "release:readiness": "bun tools/scripts/check_release_readiness.mjs",
    "release:readiness:strict": "bun tools/scripts/check_release_readiness.mjs --strict",
    "start:api": "cd backend && bun src/main.ts",
    "test:backend": "cd backend && bun run test",
    "check:contracts": "bun tools/scripts/check_api_contract_coverage.mjs",
    "check:mobile-l10n": "bun tools/scripts/check_mobile_l10n_placeholders.mjs",
    "check:product-residue": "bun tools/scripts/check_product_residue.mjs",
    "check:public-release": "bun tools/scripts/check_public_repository.mjs",
    "check:sdk-boundaries": "bun tools/scripts/check_sdk_boundaries.mjs",
    "check:surfaces": "bun tools/scripts/check_surface_docs.mjs",
    "check:capabilities": "bun tools/scripts/check_capability_docs.mjs",
    "typecheck": "cd packages/shared_types && bun run typecheck && cd ../api_contracts && bun run typecheck && cd ../ui_tokens && bun run typecheck && cd ../../backend && bun run typecheck && cd ../apps/admin_web && bun run typecheck && cd ../public_web && bun run typecheck",
    "check": "bun run typecheck && bun run check:contracts && bun run check:mobile-l10n && bun run check:product-residue && bun run check:public-release && bun run check:sdk-boundaries && bun run check:surfaces && bun run check:capabilities && bun run test:backend"
  }
}
