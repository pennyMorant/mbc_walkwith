# Image names can point to locally loaded images or a private registry.
API_IMAGE=mbc_walkwith_api
MIGRATION_IMAGE=mbc_walkwith_migration
WEB_IMAGE=mbc_walkwith_web
IMAGE_TAG=local
POSTGRES_IMAGE=postgres:16-alpine

# The password must be URL-safe because DATABASE_URL uses it verbatim.
POSTGRES_DB=mbc_walkwith
POSTGRES_USER=mbc_walkwith
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
DATABASE_URL=postgres://mbc_walkwith:replace-with-a-long-url-safe-password@postgres:5432/mbc_walkwith

# Default binding coexists with the native deployment. Set 0.0.0.0:80 only
# on a Docker-only test server with no host Nginx using that port.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
BACKEND_ENV_FILE=./backend.env
